# Copy to deploy/.env on the Spark (gitignored). Values below are spark1 defaults.

# Hugging Face token (Qwen/Qwen3-14B-AWQ is public, but the token avoids rate
# limits). The Sparks already keep one in ~/.bashrc for space-heater.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared model cache — reuse the Spark's existing cache (300+ GB of models).
HF_CACHE=/home/dev/.cache/huggingface

# Gateway state. Must be owned by uid/gid 999 with mode 700 (per ONAI). The
# file ONAI needs back lives here: .config/aardant_vllm_gateway/resource_info.bin
GATEWAY_STATE=/home/dev/okn/gateway-state

# Fraction of GPU (unified) memory vLLM may claim. 0.30 ~= 36 GB on a GB10.
# Raise only if spark1 has been cleared of other GPU workloads.
VLLM_GPU_MEM_UTIL=0.30
